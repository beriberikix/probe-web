{
  "name": "@probe-web/ui",
  "version": "0.6.0",
  "description": "Web components for flashing and debugging embedded targets from a browser, on @probe-web/client",
  "keywords": [
    "probe-rs",
    "embedded",
    "web-components",
    "lit",
    "debugger"
  ],
  "homepage": "https://beriberikix.github.io/probe-web/api/ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beriberikix/probe-web.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/beriberikix/probe-web/issues",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./device-picker": "./dist/device-picker.js",
    "./flash-panel": "./dist/flash-panel.js",
    "./rtt-terminal": "./dist/rtt-terminal.js",
    "./target-picker": "./dist/target-picker.js",
    "./semihosting-console": "./dist/semihosting-console.js",
    "./serial-monitor": "./dist/serial-monitor.js",
    "./core-controls": "./dist/core-controls.js",
    "./registers": "./dist/registers.js",
    "./callstack": "./dist/callstack.js",
    "./variables": "./dist/variables.js",
    "./breakpoints": "./dist/breakpoints.js",
    "./disassembly": "./dist/disassembly.js",
    "./memory-view": "./dist/memory-view.js",
    "./peripherals": "./dist/peripherals.js",
    "./test-runner": "./dist/test-runner.js",
    "./rtt-plot": "./dist/rtt-plot.js",
    "./theme.css": "./src/theme.css",
    "./icons": "./dist/icons.js",
    "./color-scheme": "./dist/color-scheme.js",
    "./terminal-theme": "./dist/terminal-theme.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@probe-web/client": "^0.6.0",
    "@probe-web/devices": "^0.6.0",
    "@probe-web/artifacts": "^0.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lit": "^3.2.0",
    "@probe-web/serial": "^0.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
