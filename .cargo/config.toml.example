# Build against local checkouts of the probe-rs forks instead of fetching them from GitHub.
# Copy to .cargo/config.toml (gitignored) and adjust the paths; `cargo` then uses the working
# tree, so changes there are picked up without pushing. The directories must contain the same
# crate versions as the git dependencies in crates/*/Cargo.toml.
paths = [
    "../probe-rs/probe-rs",
    "../probe-rs/probe-rs-debug",
    "../prs-wasm-rpc/probe-rs-rpc",
    "../prs-wasm-rpc/probe-rs-rpc-client",
]
