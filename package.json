{
  "name": "probe-web",
  "version": "0.5.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:workspaces": "npm test --workspaces --if-present",
    "release:pack": "npm pack -w @probe-web/devices -w @probe-web/artifacts -w @probe-web/serial -w @probe-web/client -w @probe-web/dap -w @probe-web/ui --pack-destination ../pw-release",
    "docs:api": "typedoc",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.48.0",
    "@types/w3c-web-usb": "^1.0.10",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4"
  }
}
